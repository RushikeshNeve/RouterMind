generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GatewayMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestLog {
  id                          String   @id @default(cuid())
  workspaceId                 String?
  apiKey                      String
  requestedModel              String
  selectedModel               String?
  provider                    String?
  inputTokens                 Int?
  outputTokens                Int?
  estimatedCost               Float?
  latencyMs                   Int
  status                      String
  errorMessage                String?
  providerStatusAtRouting     String?
  providerAvgLatencyAtRouting Int?
  providerSuccessRateAtRouting Float?
  routingMode                 String?
  routingStrategy             String?
  createdAt                   DateTime @default(now())
  routerDecisions  RouterDecisionLog[]
  providerAttempts ProviderAttemptLog[]
  executionPlans   ExecutionPlanLog[]
  firewallEvents   FirewallEvent[]

  @@index([workspaceId])
}

model CircuitBreakerState {
  id            String   @id @default(cuid())
  provider      String
  model         String
  state         String   @default("CLOSED")
  failureCount  Int      @default(0)
  openedAt      DateTime?
  halfOpenAt    DateTime?
  lastFailureAt DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider])
  @@index([model])
}

model ProviderAttemptLog {
  id           String   @id @default(cuid())
  requestLogId String?
  workspaceId  String?
  userId       String
  provider     String
  model        String
  attemptNumber Int
  status       String
  latencyMs    Int
  errorType    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  requestLog   RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
  @@index([provider])
  @@index([model])
  @@index([createdAt])
}

model ExecutionPlanLog {
  id               String      @id @default(cuid())
  requestLogId     String?
  workspaceId      String?
  userId           String
  planType         String
  stepsJson        Json
  estimatedCostUsd Float
  actualCostUsd    Float?
  confidence       Float
  reason           String
  executed         Boolean
  createdAt        DateTime    @default(now())
  requestLog       RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
  @@index([planType])
  @@index([createdAt])
}

model ProviderHealthMetric {
  id               String   @id @default(cuid())
  provider         String
  model            String
  status           String
  avgLatencyMs     Int
  p95LatencyMs     Int
  successRate      Float
  errorRate        Float
  timeoutRate      Float
  rateLimitRate    Float
  windowMinutes    Int
  sampleSize       Int
  lastErrorCode    String?
  lastErrorMessage String?
  lastCheckedAt    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider])
  @@index([model])
}

model RouterDecisionLog {
  id                  String   @id @default(cuid())
  requestLogId        String?
  workspaceId         String?
  userId              String
  mode                String
  routerModelUsed     String?
  detectedTask        String?
  complexity          String?
  candidateModelsJson Json
  selectedModel       String?
  selectedProvider    String?
  confidence          Float?
  reason              String?
  fallbackUsed        Boolean  @default(false)
  createdAt           DateTime @default(now())
  requestLog          RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  principalId         String?              @unique
  createdAt           DateTime             @default(now())
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  modelAccess         UserModelAccess[]
  budgets             UserBudget[]
  quotas                UsageQuota[]
  workspaceMembers      WorkspaceMember[]
  principal           Principal?           @relation(fields: [principalId], references: [id], onDelete: SetNull)
  serviceAccounts     ServiceAccount[]
}

model ServiceAccount {
  id              String    @id @default(cuid())
  principalId     String    @unique
  createdByUserId String
  description     String?
  createdAt       DateTime  @default(now())
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId])
}

model ApiKey {
  id          String     @id @default(cuid())
  keyHash     String     @unique
  userId      String
  workspaceId String?
  principalId String?
  name        String
  createdAt   DateTime   @default(now())
  isActive    Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal   Principal? @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([workspaceId])
  @@index([principalId])
}

model ProviderCredential {
  id              String     @id @default(cuid())
  userId          String
  workspaceId     String?
  provider        String
  encryptedApiKey String
  isEnabled       Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([userId, provider])
  @@index([userId])
  @@index([workspaceId])
}

model UserModelAccess {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  provider    String
  model       String
  isEnabled   Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([userId, provider, model])
  @@index([userId])
  @@index([workspaceId])
}

model UserBudget {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String?
  period          String
  maxSpendUsd     Float
  currentSpendUsd Float    @default(0)
  resetAt         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

model UsageQuota {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String?
  period          String
  maxRequests     Int
  currentRequests Int      @default(0)
  maxTokens       Int
  currentTokens   Int      @default(0)
  resetAt         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

model EvaluationDataset {
  id          String           @id @default(cuid())
  name        String
  description String?
  taskType    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cases       EvaluationCase[]
  runs        EvaluationRun[]

  @@index([taskType])
  @@index([createdAt])
}

model EvaluationCase {
  id                String            @id @default(cuid())
  datasetId         String
  inputMessagesJson Json
  expectedOutput    String
  gradingRubric     String
  metadataJson      Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dataset           EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results           EvaluationResult[]

  @@index([datasetId])
  @@index([createdAt])
}

model EvaluationRun {
  id           String             @id @default(cuid())
  datasetId    String
  model        String
  provider     String
  status       String             @default("pending")
  totalCases   Int                @default(0)
  passedCases  Int                @default(0)
  averageScore Float              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  dataset      EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([datasetId])
  @@index([provider])
  @@index([model])
  @@index([status])
  @@index([createdAt])
}

model EvaluationResult {
  id          String        @id @default(cuid())
  runId       String
  caseId      String
  modelOutput String
  score       Float
  passed      Boolean
  judgeReason String
  latencyMs   Int
  costUsd     Float
  createdAt   DateTime      @default(now())
  run         EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  case        EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([caseId])
  @@index([createdAt])
}

model LLMResponseCache {
  id                   String   @id @default(cuid())
  userId               String
  workspaceId          String?
  cacheKey             String   @unique
  normalizedPromptHash String
  promptText           String
  responseJson         Json
  model                String
  provider             String
  inputTokens          Int
  outputTokens         Int
  costSavedUsd         Float    @default(0)
  hitCount             Int      @default(0)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([normalizedPromptHash])
  @@index([expiresAt])
}

model PolicyRule {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  type      String
  pattern   String?
  action    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model FirewallEvent {
  id           String      @id @default(cuid())
  userId       String
  workspaceId  String?
  requestLogId String?
  ruleId       String?
  type         String
  action       String
  severity     String
  matchedText  String?
  message      String
  createdAt    DateTime    @default(now())
  requestLog   RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([requestLogId])
  @@index([ruleId])
  @@index([type])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  plan       String      @default("free")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  workspaces Workspace[]
}

model Principal {
  id             String          @id @default(cuid())
  type           String
  displayName    String
  createdAt      DateTime        @default(now())
  memberships    Membership[]
  users          User[]
  serviceAccount ServiceAccount?
  apiKeys        ApiKey[]
  auditEvents    AuditEvent[]
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  organizationId      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members             WorkspaceMember[]
  memberships         Membership[]
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  modelAccess         UserModelAccess[]
  auditEvents         AuditEvent[]

  @@index([organizationId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  principalId String
  role        String
  roleId      String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  roleRecord  Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, principalId])
  @@index([workspaceId])
  @@index([principalId])
  @@index([role])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  memberships Membership[]
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
}

/// Append-only. No update/delete routes should ever be added for this model.
model AuditEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  principalId  String
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([principalId])
  @@index([createdAt])
}
