generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GatewayMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestLog {
  id                          String   @id @default(cuid())
  apiKey                      String
  requestedModel              String
  selectedModel               String?
  provider                    String?
  inputTokens                 Int?
  outputTokens                Int?
  estimatedCost               Float?
  latencyMs                   Int
  status                      String
  errorMessage                String?
  providerStatusAtRouting     String?
  providerAvgLatencyAtRouting Int?
  providerSuccessRateAtRouting Float?
  routingMode                 String?
  routingStrategy             String?
  createdAt                   DateTime @default(now())
  routerDecisions RouterDecisionLog[]
}

model ProviderHealthMetric {
  id               String   @id @default(cuid())
  provider         String
  model            String
  status           String
  avgLatencyMs     Int
  p95LatencyMs     Int
  successRate      Float
  errorRate        Float
  timeoutRate      Float
  rateLimitRate    Float
  windowMinutes    Int
  sampleSize       Int
  lastErrorCode    String?
  lastErrorMessage String?
  lastCheckedAt    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider])
  @@index([model])
}

model RouterDecisionLog {
  id                  String   @id @default(cuid())
  requestLogId        String?
  userId              String
  mode                String
  routerModelUsed     String?
  detectedTask        String?
  complexity          String?
  candidateModelsJson Json
  selectedModel       String?
  selectedProvider    String?
  confidence          Float?
  reason              String?
  fallbackUsed        Boolean  @default(false)
  createdAt           DateTime @default(now())
  requestLog          RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  createdAt           DateTime             @default(now())
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  modelAccess         UserModelAccess[]
}

model ApiKey {
  id        String   @id @default(cuid())
  keyHash   String   @unique
  userId    String
  name      String
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  encryptedApiKey String
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model UserModelAccess {
  id        String  @id @default(cuid())
  userId    String
  provider  String
  model     String
  isEnabled Boolean @default(true)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, model])
  @@index([userId])
}
