generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GatewayMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RequestLog {
  id                          String   @id @default(cuid())
  workspaceId                 String?
  apiKey                      String
  requestedModel              String
  selectedModel               String?
  provider                    String?
  inputTokens                 Int?
  outputTokens                Int?
  estimatedCost               Float?
  latencyMs                   Int
  status                      String
  errorMessage                String?
  providerStatusAtRouting     String?
  providerAvgLatencyAtRouting Int?
  providerSuccessRateAtRouting Float?
  routingMode                 String?
  routingStrategy             String?
  createdAt                   DateTime @default(now())
  routerDecisions  RouterDecisionLog[]
  providerAttempts ProviderAttemptLog[]
  executionPlans   ExecutionPlanLog[]
  firewallEvents   FirewallEvent[]

  @@index([workspaceId])
}

model CircuitBreakerState {
  id            String   @id @default(cuid())
  provider      String
  model         String
  state         String   @default("CLOSED")
  failureCount  Int      @default(0)
  openedAt      DateTime?
  halfOpenAt    DateTime?
  lastFailureAt DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider])
  @@index([model])
}

model ProviderAttemptLog {
  id           String   @id @default(cuid())
  requestLogId String?
  workspaceId  String?
  userId       String
  provider     String
  model        String
  attemptNumber Int
  status       String
  latencyMs    Int
  errorType    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  requestLog   RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
  @@index([provider])
  @@index([model])
  @@index([createdAt])
}

model ExecutionPlanLog {
  id               String      @id @default(cuid())
  requestLogId     String?
  workspaceId      String?
  userId           String
  planType         String
  stepsJson        Json
  estimatedCostUsd Float
  actualCostUsd    Float?
  confidence       Float
  reason           String
  executed         Boolean
  createdAt        DateTime    @default(now())
  requestLog       RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
  @@index([planType])
  @@index([createdAt])
}

model ProviderHealthMetric {
  id               String   @id @default(cuid())
  provider         String
  model            String
  status           String
  avgLatencyMs     Int
  p95LatencyMs     Int
  successRate      Float
  errorRate        Float
  timeoutRate      Float
  rateLimitRate    Float
  windowMinutes    Int
  sampleSize       Int
  lastErrorCode    String?
  lastErrorMessage String?
  lastCheckedAt    DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, model])
  @@index([provider])
  @@index([model])
}

model RouterDecisionLog {
  id                  String   @id @default(cuid())
  requestLogId        String?
  workspaceId         String?
  userId              String
  mode                String
  routerModelUsed     String?
  detectedTask        String?
  complexity          String?
  candidateModelsJson Json
  selectedModel       String?
  selectedProvider    String?
  confidence          Float?
  reason              String?
  fallbackUsed        Boolean  @default(false)
  createdAt           DateTime @default(now())
  requestLog          RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([requestLogId])
  @@index([userId])
  @@index([workspaceId])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  principalId         String?              @unique
  createdAt           DateTime             @default(now())
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  modelAccess         UserModelAccess[]
  budgets             UserBudget[]
  quotas                UsageQuota[]
  workspaceMembers      WorkspaceMember[]
  principal           Principal?           @relation(fields: [principalId], references: [id], onDelete: SetNull)
  serviceAccounts     ServiceAccount[]
  loginTokens         LoginToken[]
}

/// Passwordless email magic-link tokens for human dashboard login. Fully
/// separate from ApiKey — this is the human auth path, API keys remain the
/// machine/programmatic path. tokenHash, never the raw token, is stored
/// here, matching ApiKey.keyHash.
/// userId is nullable to support self-serve signup: request-link now issues
/// a token for unknown emails too (storing the email directly, same pattern
/// as WorkspaceInvite), and verify creates the User/Principal/Organization/
/// Workspace on first use.
model LoginToken {
  id         String    @id @default(cuid())
  userId     String?
  email      String?
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ServiceAccount {
  id              String    @id @default(cuid())
  principalId     String    @unique
  createdByUserId String
  description     String?
  createdAt       DateTime  @default(now())
  principal       Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId])
}

model ApiKey {
  id          String     @id @default(cuid())
  keyHash     String     @unique
  userId      String
  workspaceId String?
  principalId String?
  name        String
  createdAt   DateTime   @default(now())
  isActive    Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  principal   Principal? @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([workspaceId])
  @@index([principalId])
}

model ProviderCredential {
  id              String         @id @default(cuid())
  userId          String
  workspaceId     String?
  provider        String
  encryptedApiKey String
  isEnabled       Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  routerConfigs   RouterConfig[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([workspaceId])
}

/// BYO Router Model config: which provider/model/credential a routing
/// decision should use at a given scope, so a customer's own routing
/// credentials -- not the platform's -- pay for and see their own routing
/// decisions. scopeId is a polymorphic reference (Organization.id,
/// Workspace.id, or ApiKey.id depending on scopeType) with no enforced FK,
/// since Prisma can't express "references one of several tables" -- the
/// same tradeoff WorkspaceInvite already accepts for its email-only path.
/// Validating that scopeId actually exists is an application-layer concern.
model RouterConfig {
  id            String              @id @default(cuid())
  scopeType     String
  scopeId       String
  provider      String
  model         String
  fallbackModel String?
  credentialId  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  credential    ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@unique([scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([credentialId])
}

model UserModelAccess {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  provider    String
  model       String
  isEnabled   Boolean    @default(true)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([userId, provider, model])
  @@index([userId])
  @@index([workspaceId])
}

model UserBudget {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String?
  period          String
  maxSpendUsd     Float
  currentSpendUsd Float    @default(0)
  resetAt         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

model UsageQuota {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String?
  period          String
  maxRequests     Int
  currentRequests Int      @default(0)
  maxTokens       Int
  currentTokens   Int      @default(0)
  resetAt         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

model EvaluationDataset {
  id          String           @id @default(cuid())
  name        String
  description String?
  taskType    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cases       EvaluationCase[]
  runs        EvaluationRun[]

  @@index([taskType])
  @@index([createdAt])
}

model EvaluationCase {
  id                String            @id @default(cuid())
  datasetId         String
  inputMessagesJson Json
  expectedOutput    String
  gradingRubric     String
  metadataJson      Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dataset           EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results           EvaluationResult[]

  @@index([datasetId])
  @@index([createdAt])
}

model EvaluationRun {
  id           String             @id @default(cuid())
  datasetId    String
  model        String
  provider     String
  status       String             @default("pending")
  totalCases   Int                @default(0)
  passedCases  Int                @default(0)
  averageScore Float              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  dataset      EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results      EvaluationResult[]

  @@index([datasetId])
  @@index([provider])
  @@index([model])
  @@index([status])
  @@index([createdAt])
}

model EvaluationResult {
  id          String        @id @default(cuid())
  runId       String
  caseId      String
  modelOutput String
  score       Float
  passed      Boolean
  judgeReason String
  latencyMs   Int
  costUsd     Float
  createdAt   DateTime      @default(now())
  run         EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  case        EvaluationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([caseId])
  @@index([createdAt])
}

model LLMResponseCache {
  id                   String   @id @default(cuid())
  userId               String
  workspaceId          String?
  cacheKey             String   @unique
  normalizedPromptHash String
  promptText           String
  responseJson         Json
  model                String
  provider             String
  inputTokens          Int
  outputTokens         Int
  costSavedUsd         Float    @default(0)
  hitCount             Int      @default(0)
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([workspaceId])
  @@index([normalizedPromptHash])
  @@index([expiresAt])
}

model PolicyRule {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  type      String
  pattern   String?
  action    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model FirewallEvent {
  id           String      @id @default(cuid())
  userId       String
  workspaceId  String?
  requestLogId String?
  ruleId       String?
  type         String
  action       String
  severity     String
  matchedText  String?
  message      String
  createdAt    DateTime    @default(now())
  requestLog   RequestLog? @relation(fields: [requestLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([requestLogId])
  @@index([ruleId])
  @@index([type])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  plan         String        @default("free")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workspaces   Workspace[]
  subscription Subscription?
}

/// The four billing tiers (Free/Pro/Team/Enterprise) -- pricing and request
/// limits live here so a Subscription row just references a tier instead of
/// duplicating its numbers. Enterprise has no self-serve price (priceCents
/// is 0 and includedRequests is null; featuresJson.contactSales flags it as
/// custom-quoted). Phase 1 item 2 wires real Stripe billing against this;
/// this slice is schema + seed only -- no route, no UI, no Stripe fields on
/// Plan itself (those live on Subscription).
model Plan {
  id               String         @id @default(cuid())
  name             String         @unique
  priceCents       Int
  includedRequests Int?
  featuresJson     Json
  /// Paddle's price id for this tier's checkout -- null for Free (no
  /// checkout needed) and Enterprise (contact-sales, no self-serve price).
  paddlePriceId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
}

/// One active subscription per Organization (organizationId is unique --
/// this models "a single flat subscription," not billing history). Paddle
/// is the merchant of record: it owns tax/invoicing, so nothing here
/// models tax or invoice line items -- the currentPeriod and paddle* fields are
/// synced from Paddle's subscription.created/updated/canceled webhooks
/// (Phase 1 item 2), not written directly by our own checkout flow. A
/// brand-new org has no Subscription row at all until its first successful
/// checkout completes.
model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  planId               String
  status               String       @default("active")
  paddleSubscriptionId String?
  paddleCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([paddleSubscriptionId])
}

model Principal {
  id             String          @id @default(cuid())
  type           String
  displayName    String
  createdAt      DateTime        @default(now())
  memberships    Membership[]
  users          User[]
  serviceAccount ServiceAccount?
  apiKeys        ApiKey[]
  auditEvents    AuditEvent[]
}

model Workspace {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  organizationId      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members             WorkspaceMember[]
  memberships         Membership[]
  apiKeys             ApiKey[]
  providerCredentials ProviderCredential[]
  modelAccess         UserModelAccess[]
  auditEvents         AuditEvent[]
  invites             WorkspaceInvite[]
  policies            Policy[]

  @@index([organizationId])
}

/// Declarative policy rows (budget caps, per-request cost caps, model
/// restrictions) scoped to a workspace and targeted at a role, a specific
/// user, or a specific API key. Unlike RouterConfig's scopeId, subjectId
/// here has a real enforced FK-adjacent shape (subjectType names which
/// table subjectId points at), but Prisma still can't express "references
/// one of several tables" natively, so subjectId itself is unvalidated at
/// the schema level -- same tradeoff as RouterConfig.scopeId and
/// WorkspaceInvite's email-only path.
model Policy {
  id          String   @id @default(cuid())
  workspaceId String
  subjectType String
  subjectId   String
  ruleType    String
  ruleJson    Json
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([subjectType, subjectId])
  @@index([ruleType])
}

/// Pending workspace invitations by email. Distinct from Membership because
/// Membership requires an existing Principal, and an invited email may not
/// have a User/Principal until they complete the magic-link flow for the
/// first time.
model WorkspaceInvite {
  id                   String    @id @default(cuid())
  workspaceId          String
  email                String
  role                 String
  tokenHash            String    @unique
  invitedByPrincipalId String
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([expiresAt])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  principalId String
  role        String
  roleId      String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principal   Principal @relation(fields: [principalId], references: [id], onDelete: Cascade)
  roleRecord  Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, principalId])
  @@index([workspaceId])
  @@index([principalId])
  @@index([role])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  memberships Membership[]
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  permission String
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
}

/// Append-only. No update/delete routes should ever be added for this model.
model AuditEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  principalId  String
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principal    Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@index([workspaceId])
  @@index([principalId])
  @@index([createdAt])
}
