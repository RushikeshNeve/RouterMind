{
  "name": "@routemind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "seed:dev": "dotenv -e ../../.env -- tsx src/scripts/seed-dev.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.11.1",
    "@routemind/cost-engine": "0.1.0",
    "@routemind/core": "0.1.0",
    "@routemind/observability": "0.1.0",
    "@routemind/providers": "0.1.0",
    "@routemind/routing": "0.1.0",
    "@routemind/shared": "0.1.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.11.1",
    "rimraf": "^6.0.1"
  }
}
