{
  "name": "@routemind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "db:migrate": "npx --yes --package dotenv-cli@8.0.0 --package prisma@6.19.3 dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma --skip-generate",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "npx --yes --package dotenv-cli@8.0.0 --package prisma@6.19.3 dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "backfill:tenancy": "npx --yes tsx@4.20.6 src/scripts/backfill-tenancy.ts",
    "backfill:principal-fk": "npx --yes tsx@4.20.6 src/scripts/backfill-principal-fk.ts",
    "backfill:workspace-fk": "npx --yes tsx@4.20.6 src/scripts/backfill-workspace-fk.ts",
    "backfill:membership-role": "npx --yes tsx@4.20.6 src/scripts/backfill-membership-role.ts",
    "seed:dev": "npx --yes tsx@4.20.6 src/scripts/seed-dev.ts",
    "seed:rbac": "npx --yes tsx@4.20.6 src/scripts/seed-rbac.ts",
    "qa:phase0": "npx --yes tsx@4.20.6 src/scripts/qa-phase0-dashboard-flow.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@prisma/client": "^6.11.1",
    "@routemind/core": "0.1.0",
    "@routemind/cost-engine": "0.1.0",
    "@routemind/observability": "0.1.0",
    "@routemind/providers": "0.1.0",
    "@routemind/routing": "0.1.0",
    "@routemind/shared": "0.1.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "pino": "^9.7.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.11.1",
    "rimraf": "^6.0.1"
  }
}
