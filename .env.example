NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://routemind:routemind@localhost:5432/routemind?schema=public
REDIS_URL=redis://localhost:6379
DEV_API_KEY=dev-key
CREDENTIAL_ENCRYPTION_KEY=development-credential-key-change-me
ROUTEMIND_API_URL=http://localhost:3000
NEXT_PUBLIC_ROUTEMIND_API_URL=http://localhost:3000
CORS_ORIGIN=*
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600
PROVIDER_MODE=mock
PROVIDER_TIMEOUT_MS=30000
ROUTER_LLM_ENABLED=true
ROUTER_LLM_MODEL=gpt-4o-mini
ROUTER_LLM_MAX_TOKENS=300
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
