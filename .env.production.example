NODE_ENV=production
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://routemind:change-me@postgres:5432/routemind?schema=public
REDIS_URL=redis://redis:6379

DEV_API_KEY=rm_live_replace_with_bootstrap_key
CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ROUTEMIND_API_URL=https://api.example.com
NEXT_PUBLIC_ROUTEMIND_API_URL=https://api.example.com
CORS_ORIGIN=https://dashboard.example.com

REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

PROVIDER_MODE=live
PROVIDER_TIMEOUT_MS=30000
ROUTER_LLM_ENABLED=true
ROUTER_LLM_MODEL=gpt-4o-mini
ROUTER_LLM_MAX_TOKENS=300

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
